<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/nexaglobal/settings/wcm/templates/article-page"
        jcr:primaryType="cq:PageContent"
        sling:resourceType="nexaglobal/components/page/articlepage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="nexaglobal/components/container"
            layout="responsiveGrid">
            <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/container"
                layout="responsiveGrid">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="nexaglobal/components/container"
                    layout="responsiveGrid">
                    <hero
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="nexaglobal/components/content/hero"
                        eyebrow="Insight article"
                        title="Article headline goes here"
                        description="Use this article page for editorial, newsroom, or thought leadership content with a stronger opening section."
                        primaryCtaLabel="Back to homepage"
                        primaryCtaLink="/content/nexaglobal/us/en.html"
                        panelLabel="Article format"
                        panelTitle="Foundation article template"
                        panelText="This template gives editorial pages a stronger hero treatment while reusing the same global structure components."/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        text="&lt;p>Replace this sample copy with authored article content or future Content Fragment-driven article rendering.&lt;/p>"
                        sling:resourceType="nexaglobal/components/text"
                        textIsRich="{Boolean}true"/>
                </content>
            </main>
        </root>
    </jcr:content>
</jcr:root>
