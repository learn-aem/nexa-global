<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/nexaglobal/settings/wcm/templates/homepage"
        jcr:primaryType="cq:PageContent"
        sling:resourceType="nexaglobal/components/page/homepage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="nexaglobal/components/container"
            layout="responsiveGrid">
            <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/container"
                layout="responsiveGrid">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="nexaglobal/components/container"
                    layout="responsiveGrid">
                    <hero
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="nexaglobal/components/content/hero"
                        eyebrow="AEM Learning Hub"
                        title="Your guide to mastering Adobe Experience Manager."
                        description="Start your AEM journey here. This homepage template provides a structured layout for organizing tutorials, core concepts, and hands-on learning resources for AEM developers."
                        primaryCtaLabel="Browse Tutorials"
                        primaryCtaLink="#tutorials"
                        secondaryCtaLabel="View Concepts"
                        secondaryCtaLink="#concepts"
                        panelLabel="Getting started"
                        panelTitle="Built on real AEM patterns"
                        panelText="This template uses custom components, editable templates, Sling Models, and SCSS — the same patterns you will learn about."/>
                    <title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="nexaglobal/components/title"
                        jcr:title="What You Will Learn"
                        type="h2"/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="nexaglobal/components/text"
                        text="&lt;p id=&quot;concepts&quot;>Replace this section with an overview of your AEM learning content. Cover topics like &lt;strong>editable templates&lt;/strong>, &lt;strong>custom components with HTL&lt;/strong>, &lt;strong>Sling Models&lt;/strong>, &lt;strong>content architecture&lt;/strong>, and &lt;strong>dispatcher caching&lt;/strong>. Use the card list component below to highlight key topics, and the article list to surface your latest tutorials.&lt;/p>"
                        textIsRich="{Boolean}true"/>
                </content>
            </main>
        </root>
    </jcr:content>
</jcr:root>
