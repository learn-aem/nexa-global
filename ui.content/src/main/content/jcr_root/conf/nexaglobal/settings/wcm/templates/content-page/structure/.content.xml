<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:deviceGroups="[mobile/groups/responsive]"
        cq:template="/conf/nexaglobal/settings/wcm/templates/content-page"
        jcr:primaryType="cq:PageContent"
        sling:resourceType="nexaglobal/components/page/contentpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="nexaglobal/components/container"
            layout="responsiveGrid">
            <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/structure/header"
                eyebrow="NexaGlobal"
                brandTitle="NexaGlobal"
                tagline="Reusable structure for corporate content pages"
                homeLink="/content/nexaglobal/us/en"
                navLabelOne="Overview"
                navLinkOne="/content/nexaglobal/us/en.html#overview"
                navLabelTwo="Capabilities"
                navLinkTwo="/content/nexaglobal/us/en.html#capabilities"
                navLabelThree="Contact"
                navLinkThree="/content/nexaglobal/us/en.html#contact"
                ctaLabel="Request demo"
                ctaLink="/content/nexaglobal/us/en.html#contact"/>
            <breadcrumb
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/breadcrumb"
                hideCurrent="{Boolean}false"
                startLevel="{Long}3"/>
            <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/container"
                layout="responsiveGrid">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="nexaglobal/components/container"
                    editable="{Boolean}true"
                    layout="responsiveGrid"/>
            </main>
            <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/structure/footer"
                eyebrow="Corporate delivery"
                title="Reusable content page shell."
                text="Use this template for regional information pages that should inherit the same header and footer structure as the homepage."
                linkLabelOne="Homepage"
                linkUrlOne="/content/nexaglobal/us/en.html"
                linkLabelTwo="Capabilities"
                linkUrlTwo="/content/nexaglobal/us/en.html#capabilities"
                linkLabelThree="Contact"
                linkUrlThree="/content/nexaglobal/us/en.html#contact"
                copyright="Copyright NexaGlobal. Content page template."/>
        </root>
        <cq:responsive jcr:primaryType="nt:unstructured">
            <breakpoints jcr:primaryType="nt:unstructured">
                <phone
                    jcr:primaryType="nt:unstructured"
                    title="Smaller Screen"
                    width="{Long}768"/>
                <tablet
                    jcr:primaryType="nt:unstructured"
                    title="Tablet"
                    width="{Long}1200"/>
            </breakpoints>
        </cq:responsive>
    </jcr:content>
</jcr:root>
