<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/nexaglobal/settings/wcm/templates/content-page"
        jcr:primaryType="cq:PageContent"
        sling:resourceType="nexaglobal/components/page/contentpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="nexaglobal/components/container"
            layout="responsiveGrid">
            <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/container"
                layout="responsiveGrid">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="nexaglobal/components/container"
                    layout="responsiveGrid">
                    <title
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Business capability overview"
                        sling:resourceType="nexaglobal/components/title"
                        type="h1"/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        text="&lt;p>Use this template for evergreen enterprise content such as service overviews, operating model pages, compliance summaries, regional program information, or internal capability descriptions.&lt;/p>&lt;p>Start with a concise business summary, then explain ownership, scope, customer or employee impact, and the next action the visitor should take. Keep the structure stable so the page can be reused across regions without redesign.&lt;/p>&lt;p>Recommended next edits: replace this copy with the actual business narrative, add supporting sections or media below, and keep the breadcrumb and page title aligned with the information architecture.&lt;/p>"
                        sling:resourceType="nexaglobal/components/text"
                        textIsRich="{Boolean}true"/>
                </content>
            </main>
        </root>
    </jcr:content>
</jcr:root>
