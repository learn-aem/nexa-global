<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/nexaglobal/settings/wcm/templates/page-content"
        jcr:primaryType="cq:PageContent"
        sling:resourceType="nexaglobal/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="nexaglobal/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/container"
                layout="responsiveGrid">
                <title
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Page objective"
                    sling:resourceType="nexaglobal/components/title"
                    type="h1"/>
                <container
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="nexaglobal/components/container"
                    layout="responsiveGrid">
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="nexaglobal/components/text"
                        text="&lt;p>Use this general page template when you need a simple enterprise page with standard header, breadcrumb, and footer behavior. It is suitable for utility content, support information, and pages that do not require a dedicated homepage or article treatment.&lt;/p>&lt;p>Replace this starter copy with the page purpose, audience, and the information or action users should leave with.&lt;/p>"
                        textIsRich="{Boolean}true"/>
                </container>
            </container>
        </root>
    </jcr:content>
</jcr:root>
