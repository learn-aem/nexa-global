<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:allowedTemplates="[/conf/nexaglobal/settings/wcm/templates/(?!xf-).*]"
        pageTitle="NexaGlobal Language Master"
        jcr:primaryType="cq:PageContent"
        jcr:title="English Master"
        cq:template="/conf/nexaglobal/settings/wcm/templates/homepage"
        sling:resourceType="nexaglobal/components/page/homepage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="nexaglobal/components/container"
            layout="responsiveGrid">
            <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/structure/header"
                eyebrow="NexaGlobal"
                brandTitle="NexaGlobal"
                tagline="English blueprint for regional rollout"
                homeLink="/content/nexaglobal/language-masters/en"
                navLabelOne="Overview"
                navLinkOne="#overview"
                navLabelTwo="Capabilities"
                navLinkTwo="#capabilities"
                navLabelThree="Contact"
                navLinkThree="#contact"
                ctaLabel="Review blueprint"
                ctaLink="#contact"/>
            <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/container"
                layout="responsiveGrid">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="nexaglobal/components/container"
                    layout="responsiveGrid">
                    <hero
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="nexaglobal/components/content/hero"
                        eyebrow="Language master"
                        title="Blueprint content for future live copies."
                        description="This master page mirrors the foundation homepage structure so regional rollouts can later align on a common shell before local overrides are introduced."
                        primaryCtaLabel="Inspect structure"
                        primaryCtaLink="#capabilities"
                        secondaryCtaLabel="Plan rollout"
                        secondaryCtaLink="#contact"
                        panelLabel="Blueprint state"
                        panelTitle="Ready for MSM later"
                        panelText="Live copy setup is intentionally deferred until the first page template and content model are stable."/>
                    <title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="nexaglobal/components/title"
                        jcr:title="Why the blueprint comes first"
                        type="h2"/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="nexaglobal/components/text"
                        text="&lt;p id=&quot;capabilities&quot;>The English language master now shares the same foundation components as the US homepage. This prevents the project from mixing final implementation work with archetype placeholders.&lt;/p>"
                        textIsRich="{Boolean}true"/>
                </content>
            </main>
            <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/structure/footer"
                eyebrow="Blueprint governance"
                title="Stabilize the shell before enabling inheritance."
                text="Once content pages and article pages exist, this master structure can back regional live copies cleanly."
                linkLabelOne="Overview"
                linkUrlOne="#overview"
                linkLabelTwo="Capabilities"
                linkUrlTwo="#capabilities"
                linkLabelThree="Contact"
                linkUrlThree="#contact"
                copyright="Copyright NexaGlobal. English blueprint foundation."/>
        </root>
    </jcr:content>
</jcr:root>
