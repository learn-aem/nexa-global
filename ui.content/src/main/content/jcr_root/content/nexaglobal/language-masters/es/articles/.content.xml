<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:allowedTemplates="[/conf/nexaglobal/settings/wcm/templates/(?!xf-).*]"
        pageTitle="Artículos"
        jcr:primaryType="cq:PageContent"
        jcr:title="Artículos"
        cq:template="/conf/nexaglobal/settings/wcm/templates/content-page"
        sling:resourceType="nexaglobal/components/page/contentpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="nexaglobal/components/container"
            layout="responsiveGrid">
            <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/experiencefragment"
                fragmentVariationPath="/content/experience-fragments/nexaglobal/language-masters/es/site/header/master"/>
            <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/container"
                layout="responsiveGrid">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="nexaglobal/components/container"
                    layout="responsiveGrid">
                    <title
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Artículos de aprendizaje"
                        sling:resourceType="nexaglobal/components/title"
                        type="h1"/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="nexaglobal/components/text"
                        text="&lt;p>Esta sección contiene artículos de aprendizaje que explican conceptos de AEM en un formato que los futuros sitios regionales pueden reutilizar. Cada artículo debe centrarse en un tema, mostrar un objetivo de aprendizaje claro y proporcionar pasos prácticos a seguir.&lt;/p>&lt;p>Comienza con los artículos a continuación y expande la sección a medida que la plantilla crece hacia un portal de aprendizaje más completo.&lt;/p>"
                        textIsRich="{Boolean}true"/>
                    <title
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Artículos destacados"
                        sling:resourceType="nexaglobal/components/title"
                        type="h2"/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="nexaglobal/components/text"
                        text="&lt;ul>&lt;li>&lt;a href=&quot;/content/nexaglobal/language-masters/es/articles/getting-started-with-aem.html&quot;>Primeros Pasos con AEM Sites&lt;/a> explica el entorno de ejecución principal, el modelo de página y los conceptos de plantillas que los estudiantes deben comprender primero.&lt;/li>&lt;li>&lt;a href=&quot;/content/nexaglobal/language-masters/es/articles/dispatcher-caching-basics.html&quot;>Fundamentos de Dispatcher y Caché&lt;/a> presenta la capa de entrega y la mentalidad necesaria para depurar el comportamiento en caché versus sin caché.&lt;/li>&lt;/ul>"
                        textIsRich="{Boolean}true"/>
                </content>
            </main>
            <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/experiencefragment"
                fragmentVariationPath="/content/experience-fragments/nexaglobal/language-masters/es/site/footer/master"/>
        </root>
    </jcr:content>
</jcr:root>
