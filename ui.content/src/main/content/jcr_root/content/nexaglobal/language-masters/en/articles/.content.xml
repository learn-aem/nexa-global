<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:allowedTemplates="[/conf/nexaglobal/settings/wcm/templates/(?!xf-).*]"
        pageTitle="Articles"
        jcr:primaryType="cq:PageContent"
        jcr:title="Articles"
        cq:template="/conf/nexaglobal/settings/wcm/templates/content-page"
        sling:resourceType="nexaglobal/components/page/contentpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="nexaglobal/components/container"
            layout="responsiveGrid">
            <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/structure/header"
                eyebrow="NexaGlobal"
                brandTitle="NexaGlobal"
                tagline="English blueprint for regional rollout"
                homeLink="/content/nexaglobal/language-masters/en"
                navLabelOne="Homepage"
                navLinkOne="/content/nexaglobal/language-masters/en.html"
                navLabelTwo="Articles"
                navLinkTwo="/content/nexaglobal/language-masters/en/articles.html"
                navLabelThree="About Me"
                navLinkThree="/content/nexaglobal/language-masters/en/about-me.html"
                ctaLabel="Chat on WhatsApp"
                ctaLink="https://wa.me/919390297440?text=Hi%20I%20want%20to%20know%20more%20about%20AEM"/>
            <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/container"
                layout="responsiveGrid">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="nexaglobal/components/container"
                    layout="responsiveGrid">
                    <title
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Learning articles"
                        sling:resourceType="nexaglobal/components/title"
                        type="h1"/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="nexaglobal/components/text"
                        text="&lt;p>This section holds authored learning articles that explain AEM concepts in a format future regional sites can reuse. Each article should focus on one topic, show a clear learning objective, and provide practical next steps.&lt;/p>&lt;p>Start with the articles below and expand the section as the blueprint grows into a fuller learning portal.&lt;/p>"
                        textIsRich="{Boolean}true"/>
                    <title
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Featured articles"
                        sling:resourceType="nexaglobal/components/title"
                        type="h2"/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="nexaglobal/components/text"
                        text="&lt;ul>&lt;li>&lt;a href=&quot;/content/nexaglobal/language-masters/en/articles/getting-started-with-aem.html&quot;>Getting Started with AEM Sites&lt;/a> explains the core runtime, page model, and template concepts learners should understand first.&lt;/li>&lt;li>&lt;a href=&quot;/content/nexaglobal/language-masters/en/articles/dispatcher-caching-basics.html&quot;>Dispatcher and Caching Basics&lt;/a> introduces the delivery layer and the mindset needed to debug cached versus uncached behavior.&lt;/li>&lt;/ul>"
                        textIsRich="{Boolean}true"/>
                </content>
            </main>
            <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/structure/footer"
                eyebrow="Blueprint governance"
                title="Use articles to teach one concept at a time."
                text="Keep each article focused, reusable, and strong enough to survive future rollout into regional learning experiences."
                linkLabelOne="Homepage"
                linkUrlOne="/content/nexaglobal/language-masters/en.html"
                linkLabelTwo="Articles"
                linkUrlTwo="/content/nexaglobal/language-masters/en/articles.html"
                linkLabelThree="About Me"
                linkUrlThree="/content/nexaglobal/language-masters/en/about-me.html"
                copyright="Copyright NexaGlobal. English learning blueprint."/>
        </root>
    </jcr:content>
</jcr:root>
