<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:allowedTemplates="[/conf/nexaglobal/settings/wcm/templates/(?!xf-).*]"
        pageTitle="लेख"
        jcr:primaryType="cq:PageContent"
        jcr:title="लेख"
        cq:template="/conf/nexaglobal/settings/wcm/templates/content-page"
        sling:resourceType="nexaglobal/components/page/contentpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="nexaglobal/components/container"
            layout="responsiveGrid">
            <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/experiencefragment"
                fragmentVariationPath="/content/experience-fragments/nexaglobal/language-masters/hi/site/header/master"/>
            <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/container"
                layout="responsiveGrid">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="nexaglobal/components/container"
                    layout="responsiveGrid">
                    <title
                        jcr:primaryType="nt:unstructured"
                        jcr:title="शिक्षण लेख"
                        sling:resourceType="nexaglobal/components/title"
                        type="h1"/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="nexaglobal/components/text"
                        text="&lt;p>इस अनुभाग में लिखित शिक्षण लेख हैं जो AEM अवधारणाओं को एक ऐसे प्रारूप में समझाते हैं जिसे भविष्य की क्षेत्रीय साइटें पुन: उपयोग कर सकती हैं।&lt;/p>"
                        textIsRich="{Boolean}true"/>
                </content>
            </main>
            <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="nexaglobal/components/experiencefragment"
                fragmentVariationPath="/content/experience-fragments/nexaglobal/language-masters/hi/site/footer/master"/>
        </root>
    </jcr:content>
</jcr:root>
